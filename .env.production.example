POSTGRES_DB=vestidor_virtual
POSTGRES_USER=vestidor
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode special characters in the database password below.
DATABASE_URL=postgresql+psycopg2://vestidor:REPLACE_WITH_RANDOM_PASSWORD@database:5432/vestidor_virtual
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EXPOSE_RESET_TOKEN=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Required in production for password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
CORS_ORIGINS=https://vestidor.example.com
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=BOB
PAYMENT_SIMULATION_MODE=false
FASHN_API_KEY=
WEB_BIND=127.0.0.1
WEB_PORT=8080
