POSTGRES_DB=vestidor_virtual
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SECRET_KEY=change-me-before-production
EXPOSE_RESET_TOKEN=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Configure these to send password-recovery tokens by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=BOB
# true: accepts demo card/QR/cash payments locally. Set false in production.
PAYMENT_SIMULATION_MODE=true
FASHN_API_KEY=
